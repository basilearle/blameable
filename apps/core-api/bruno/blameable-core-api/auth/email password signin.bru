meta {
  name: email password signin
  type: http
  seq: 1
}

post {
  url: http://localhost:3000/api/auth/sign-in/email
  body: json
  auth: inherit
}

headers {
  Origin: http://localhost:4200
}

body:json {
  {
    "email": "test@domain.com",
    "password": "password"
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
